<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9 nie zna nowszych certyfikatów głównych Let's Encrypt (X2, YE, YR), na których stoją
     Open-Meteo i wttr.in, więc dokładamy je do systemowych. Ruch nieszyfrowany pozostaje zablokowany. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/isrg_root_ye" />
            <certificates src="@raw/isrg_root_yr" />
        </trust-anchors>
    </base-config>
</network-security-config>
